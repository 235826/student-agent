{
  "name": "student-agent-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <27"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "check": "tsc -b && eslint .",
    "test": "vitest run",
    "generate:api": "openapi-typescript ../docs/openapi.json -o src/generated/api.d.ts",
    "test:e2e": "playwright test",
    "format": "prettier --write src e2e *.ts *.js *.json"
  },
  "dependencies": {
    "@fullcalendar/core": "^6.1.0",
    "@fullcalendar/daygrid": "^6.1.0",
    "@fullcalendar/list": "^6.1.0",
    "@fullcalendar/luxon3": "^6.1.0",
    "@fullcalendar/react": "^6.1.0",
    "@fullcalendar/timegrid": "^6.1.0",
    "@tanstack/react-query": "^5.66.0",
    "antd": "^5.24.0",
    "luxon": "^3.6.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@playwright/test": "^1.51.0",
    "@testing-library/jest-dom": "^6.0.0",
    "@testing-library/react": "^16.0.0",
    "@types/luxon": "^3.6.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "eslint": "^9.0.0",
    "eslint-plugin-react-hooks": "^7.0.0",
    "globals": "^16.0.0",
    "jsdom": "^26.0.0",
    "openapi-typescript": "^7.6.0",
    "prettier": "^3.9.10",
    "typescript": "~5.9.0",
    "typescript-eslint": "^8.0.0",
    "vite": "^7.0.0",
    "vitest": "^5.0.5"
  }
}
