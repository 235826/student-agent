SA_DATABASE_URL=sqlite:///../data/student_agent.db
SA_ALLOWED_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:8080","http://127.0.0.1:8080"]
SA_COOKIE_SECURE=false
# 包含 /v1 等服务商 API 前缀，不包含 /chat/completions；远程必须使用 HTTPS
SA_LLM_BASE_URL=
SA_LLM_MODEL=
SA_LLM_API_KEY=
# 仅在模型确实支持图片输入时启用
SA_LLM_SUPPORTS_IMAGES=false
SA_LLM_TIMEOUT_SECONDS=60
SA_SOURCE_DIR=../data/sources
